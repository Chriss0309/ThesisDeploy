// Row-level security cannot be expressed here: every migration that creates a
// table must also `ENABLE ROW LEVEL SECURITY` on it (see the init migration).
// No policies are defined, so Supabase's anon/authenticated roles get nothing;
// the app connects as the table owner and is unaffected.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// OIDC `sub` from the SnapTrade id_token.
  snaptradeUserId String   @unique @map("snaptrade_user_id")
  email           String?
  emailVerified   Boolean? @map("email_verified")
  name            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt     DateTime @default(now()) @map("last_login_at") @db.Timestamptz(6)

  sessions  Session[]
  grant     OauthGrant?
  events    Event[]
  apiCalls  ApiCall[]
  snapshots AccountSnapshot[]
  theses    Thesis[]
  baskets   Basket[]

  @@map("app_users")
}

model Session {
  /// HMAC-SHA256 (hex) of the opaque cookie token, keyed by SESSION_SECRET;
  /// the raw token is never stored.
  id        String    @id
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Single-use PKCE/OIDC state, consumed with DELETE ... RETURNING.
model OauthLoginAttempt {
  state           String   @id
  codeVerifierEnc String   @map("code_verifier_enc")
  nonce           String
  returnTo        String?  @map("return_to")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("oauth_login_attempts")
}

/// Refresh tokens rotate: update this row under SELECT ... FOR UPDATE.
model OauthGrant {
  userId          String   @id @map("user_id") @db.Uuid
  accessTokenEnc  String   @map("access_token_enc")
  refreshTokenEnc String   @map("refresh_token_enc")
  accessExpiresAt DateTime @map("access_expires_at") @db.Timestamptz(6)
  scope           String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_grants")
}

model Event {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  /// Keyed hash of the guest demo cookie (the same value as baskets.guest_key)
  /// on guest demo events; null otherwise.
  guestKey  String?  @map("guest_key")
  name      String
  props     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId])
  @@index([guestKey, createdAt])
  @@map("events")
}

model ApiCall {
  id               BigInt   @id @default(autoincrement())
  userId           String?  @map("user_id") @db.Uuid
  operation        String
  brokerageSlug    String?  @map("brokerage_slug")
  /// Hashed account ID; raw account IDs and numbers never reach telemetry.
  accountHash      String?  @map("account_hash")
  /// Null when no response arrived (timeout or network error).
  httpStatus       Int?     @map("http_status")
  latencyMs        Int      @map("latency_ms")
  requestId        String?  @map("request_id")
  accountRemaining Int?     @map("account_remaining")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([operation, createdAt])
  @@index([userId])
  @@index([accountHash, createdAt])
  @@index([createdAt])
  @@map("api_calls")
}

/// Normalized balances and positions per account, cached so page views stay
/// inside SnapTrade's 10 requests/minute/account limit. Deleted on disconnect.
model AccountSnapshot {
  userId    String    @map("user_id") @db.Uuid
  accountId String    @map("account_id")
  balances  Json
  positions Json
  /// When SnapTrade fetched the data from the brokerage, if reported.
  dataAsOf  DateTime? @map("data_as_of") @db.Timestamptz(6)
  fetchedAt DateTime  @map("fetched_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@map("account_snapshots")
}

/// One Claude generation and the context it ran with. Guest demo theses have
/// no user; they double as the cache for preset and repeated guest prompts.
model Thesis {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  /// Keyed hash of a guest's IP for custom prompts; never the address itself.
  guestClient  String?  @map("guest_client")
  accountId    String   @map("account_id")
  prompt       String
  /// SHA-256 of the normalized prompt, for cache lookups.
  promptHash   String   @map("prompt_hash")
  presetKey    String?  @map("preset_key")
  budget       Decimal  @db.Decimal(14, 2)
  currency     String
  overlapMode  String   @map("overlap_mode")
  model        String
  /// Raw structured output, kept for auditing.
  llmOutput    Json     @map("llm_output")
  title        String
  summary      String
  riskProfile  String   @map("risk_profile")
  latencyMs    Int      @map("latency_ms")
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       AppUser?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates ThesisCandidate[]
  baskets    Basket[]

  @@index([userId, createdAt])
  @@index([promptHash, createdAt])
  @@map("theses")
}

/// Every ticker Claude proposed and what grounding did with it; the source
/// for the symbol-resolution hit rate.
model ThesisCandidate {
  thesisId          String   @map("thesis_id") @db.Uuid
  seq               Int
  ticker            String
  companyName       String   @map("company_name")
  rationale         String
  /// Claude's weight, normalized over every valid proposal.
  llmWeight         Float?   @map("llm_weight")
  /// resolved, not_found, untradeable, currency_mismatch, no_price, duplicate, or invalid
  resolutionStatus  String   @map("resolution_status")
  detail            String?
  symbol            String?
  universalSymbolId String?  @map("universal_symbol_id")
  price             Decimal? @db.Decimal(18, 4)
  /// snaptrade or demo, then ask or last.
  priceSource       String?  @map("price_source")
  overlapValue      Decimal? @map("overlap_value") @db.Decimal(14, 2)
  adjustedWeight    Float?   @map("adjusted_weight")
  units             Int?

  thesis Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@id([thesisId, seq])
  @@map("thesis_candidates")
}

/// A Virtual Basket: the constituents a user confirmed at pre-flight and the
/// shares this app filled for them. The ledger changes only from fills, and
/// paper and live baskets are never mixed. Guest demo baskets have no user;
/// the demo cookie owns them.
model Basket {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  /// Keyed hash of the guest demo cookie; null for signed-in baskets.
  guestKey        String?   @map("guest_key")
  /// Keyed hash of a guest's IP, for the demo's daily limits.
  guestClient     String?   @map("guest_client")
  thesisId        String?   @map("thesis_id") @db.Uuid
  accountId       String    @map("account_id")
  accountName     String    @map("account_name")
  institution     String
  brokerageSlug   String?   @map("brokerage_slug")
  /// Hashed account ID (per guest for demo accounts): the pacing and one-active-execution key.
  accountKey      String    @map("account_key")
  /// paper or live; null until an execution is confirmed.
  mode            String?
  /// draft, deploying, active, or closed
  status          String    @default("draft")
  currency        String
  budget          Decimal   @db.Decimal(14, 2)
  title           String
  summary         String
  riskProfile     String    @map("risk_profile")
  /// The deploy pre-flight: order list, quotes, market status, and Live gating.
  preflight       Json
  preflightAt     DateTime  @map("preflight_at") @db.Timestamptz(6)
  /// Cost of the deploy fills: the capital put into the basket.
  contributed     Decimal   @default(0) @db.Decimal(16, 4)
  /// Proceeds of rebalance and close sells, less rebalance buys.
  cash            Decimal   @default(0) @db.Decimal(16, 4)
  /// The latest rebalance or close pre-flight (same shape as `preflight`, plus `id` and `kind`).
  actionPreflight Json?     @map("action_preflight")
  /// Cached prices for valuation: { source, asOf, prices: { SYMBOL: { last, bid, ask } } }.
  marks           Json?
  markedAt        DateTime? @map("marked_at") @db.Timestamptz(6)
  /// Guest demo only: price multipliers from the "Simulate a market move" reviewer tool.
  simulatedMoves  Json?     @map("simulated_moves")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deployedAt      DateTime? @map("deployed_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)

  user         AppUser?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  thesis       Thesis?             @relation(fields: [thesisId], references: [id], onDelete: SetNull)
  constituents BasketConstituent[]
  executions   Execution[]

  @@index([userId, createdAt])
  @@index([guestKey, createdAt])
  @@index([guestClient, createdAt])
  @@map("baskets")
}

model BasketConstituent {
  basketId          String  @map("basket_id") @db.Uuid
  symbol            String
  universalSymbolId String? @map("universal_symbol_id")
  companyName       String  @map("company_name")
  /// Renormalized over the names that have orders.
  targetWeight      Float   @map("target_weight")
  /// Whole shares the user confirmed at pre-flight.
  plannedUnits      Int     @map("planned_units")
  /// Filled shares; written only together with a filled leg.
  ledgerUnits       Int     @default(0) @map("ledger_units")
  /// Cost basis of the shares still held (average cost).
  costTotal         Decimal @default(0) @map("cost_total") @db.Decimal(16, 4)
  /// Sale proceeds less the average cost of the shares sold.
  realizedTotal     Decimal @default(0) @map("realized_total") @db.Decimal(16, 4)

  basket Basket @relation(fields: [basketId], references: [id], onDelete: Cascade)

  @@id([basketId, symbol])
  @@map("basket_constituents")
}

/// One confirmed run of orders for a basket. Legs are drained at most one per
/// 1.1 seconds per account by `POST /api/executions/:id/drain`.
model Execution {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  basketId          String    @map("basket_id") @db.Uuid
  accountKey        String    @map("account_key")
  /// Equals account_key while queued or running and is null otherwise, so the
  /// unique index allows one active execution per account (NULLs never collide).
  activeAccountKey  String?   @unique @map("active_account_key")
  /// deploy, rebalance, or close
  kind              String
  /// paper or live
  mode              String
  /// queued, running, completed, partial, failed, or canceled
  status            String
  /// Client-generated per confirmation; a repeated POST returns the same execution.
  idempotencyKey    String    @unique @map("idempotency_key")
  /// The pre-flight this execution confirmed; each pre-flight runs at most once.
  preflightId       String?   @unique @map("preflight_id") @db.Uuid
  /// What the user confirmed: order list, quotes, market status, disclosures.
  confirmation      Json
  /// Paper only: the leg whose first attempt is rejected (reviewer failure injection).
  simulateRejectSeq Int?      @map("simulate_reject_seq")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)

  basket Basket         @relation(fields: [basketId], references: [id], onDelete: Cascade)
  legs   ExecutionLeg[]

  @@index([basketId, createdAt])
  @@map("executions")
}

/// One order attempt. A retry is a new row with the same seq, the next
/// attempt number, and a new client_order_id.
model ExecutionLeg {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId       String    @map("execution_id") @db.Uuid
  /// 1-based position in the confirmed order list.
  seq               Int
  attempt           Int       @default(1)
  /// BUY or SELL
  action            String
  symbol            String
  universalSymbolId String?   @map("universal_symbol_id")
  units             Int
  /// The pre-flight quote; paper legs fill here.
  estPrice          Decimal   @map("est_price") @db.Decimal(18, 4)
  clientOrderId     String    @default(dbgenerated("gen_random_uuid()")) @map("client_order_id") @db.Uuid
  /// pending, claimed, executed, accepted, partial, rejected, failed, unknown, or skipped
  status            String    @default("pending")
  /// A rate-limited leg waits until then.
  notBefore         DateTime? @map("not_before") @db.Timestamptz(6)
  brokerageOrderId  String?   @map("brokerage_order_id")
  snaptradeStatus   String?   @map("snaptrade_status")
  filledUnits       Int?      @map("filled_units")
  fillPrice         Decimal?  @map("fill_price") @db.Decimal(18, 4)
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message")
  requestId         String?   @map("request_id")
  latencyMs         Int?      @map("latency_ms")
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(6)
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, seq, attempt])
  @@index([executionId, status])
  @@map("execution_legs")
}

/// Last order submission per account, shared by every serverless instance:
/// a leg is submitted only after reserving a slot 1.1 seconds past this.
model AccountPacing {
  accountKey   String   @id @map("account_key")
  lastSubmitAt DateTime @map("last_submit_at") @db.Timestamptz(6)

  @@map("account_pacing")
}
