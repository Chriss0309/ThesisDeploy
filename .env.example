# Copy to .env.local for local development. Never commit real values.
# Every variable is optional at build time; /api/health reports which
# features are configured.

APP_BASE_URL=http://127.0.0.1:3000

# Supabase Postgres. The app uses the transaction pooler (port 6543).
# Prisma CLI commands (npm run db:migrate) use the session pooler or direct
# connection. SHADOW_DATABASE_URL is an empty scratch database, needed only for
# npm run db:migrate:dev and npm run db:drift.
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=

# SnapTrade OAuth app (Dashboard -> OAuth Apps), not the Commercial API keys.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
SNAPTRADE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# SNAPTRADE_OAUTH_SCOPES=openid email profile read trade
# SNAPTRADE_ISSUER=https://api.snaptrade.com
# SNAPTRADE_API_BASE_URL=https://api.snaptrade.com
# Local testing without a SnapTrade OAuth app: run `npm run dev:oauth-stub` and set
# SNAPTRADE_ISSUER=http://127.0.0.1:4010, SNAPTRADE_OAUTH_CLIENT_ID=stub-client,
# SNAPTRADE_OAUTH_CLIENT_SECRET=stub-secret (see docs/sign-in.md).

# 32 random bytes, base64: openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Claude calls the guest demo may make per rolling 24 hours, across all visitors; 0 turns them off.
# GUEST_GENERATIONS_PER_DAY=40
# Local testing without Anthropic: run `npm run dev:anthropic-stub` and set
# ANTHROPIC_API_KEY=stub and ANTHROPIC_BASE_URL=http://127.0.0.1:4030 (see docs/thesis-studio.md).

# Kill switch for real brokerage orders, checked on every leg. Keep false outside
# Production. Live submission isn't wired yet, so Live stays disabled either way.
LIVE_TRADING_ENABLED=false
