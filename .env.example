# Copy to .env.local for local development. Never commit real values.
# Every variable is optional at build time; /api/health reports which
# features are configured.

APP_BASE_URL=http://127.0.0.1:3000

# SnapTrade OAuth app (Dashboard -> OAuth Apps), not the Commercial API keys.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
SNAPTRADE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# SNAPTRADE_OAUTH_SCOPES=openid email profile read trade
# SNAPTRADE_ISSUER=https://api.snaptrade.com

# 32 random bytes, base64: openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Kill switch for real brokerage orders. Keep false outside Production.
LIVE_TRADING_ENABLED=false
