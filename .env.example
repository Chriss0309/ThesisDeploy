# Copy to .env.local for local development. Never commit real values.
# Every variable is optional at build time, so builds and Vercel previews work
# without secrets; each feature checks its own variables, and /api/health reports
# which features are configured (booleans only, never values).
# README.md ("Deployment") lists which ones Production needs.

# --- Database (Supabase Postgres) -------------------------------------------
# Runtime connection: Supabase transaction pooler (port 6543). Needed for sign-in,
# Thesis Studio, Paper and Live execution, My Theses, and telemetry.
DATABASE_URL=
# Prisma CLI only (npm run db:migrate): the session pooler (5432) or direct connection.
DIRECT_URL=
# An empty scratch database, needed only by npm run db:migrate:dev and npm run db:drift.
SHADOW_DATABASE_URL=
# Integration tests only: a migrated local database that the tests truncate. Never Supabase.
# TEST_DATABASE_URL=postgresql://localhost:5432/thesisdeploy_test

# --- Sign in with SnapTrade (OAuth app, not the Commercial API keys) ---------
# Dashboard -> OAuth Apps. Sign-in also needs SESSION_SECRET, TOKEN_ENCRYPTION_KEY,
# and DATABASE_URL.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# Must match a registered redirect URI exactly. Production:
# https://thesisdeploy.vercel.app/api/auth/callback
SNAPTRADE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# Optional. Must include openid and read; trade is needed for Live orders.
# SNAPTRADE_OAUTH_SCOPES=openid email profile read trade
# Optional; defaults to SnapTrade. Point both at the local stubs for testing:
# npm run dev:oauth-stub (SNAPTRADE_ISSUER=http://127.0.0.1:4010, client stub-client / stub-secret)
# npm run dev:api-stub   (SNAPTRADE_API_BASE_URL=http://127.0.0.1:4020). See docs/sign-in.md.
# SNAPTRADE_ISSUER=https://api.snaptrade.com
# SNAPTRADE_API_BASE_URL=https://api.snaptrade.com

# 32 random bytes each, base64: openssl rand -base64 32
# SESSION_SECRET keys session IDs and telemetry hashes (rotating it signs everyone out).
# TOKEN_ENCRYPTION_KEY encrypts OAuth tokens at rest; rotating it leaves stored grants
# unreadable, so delete oauth_grants when you rotate it and users sign in again.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Thesis generation (Anthropic) ------------------------------------------
# Without a key, signed-in generation is off and the demo serves committed sample baskets.
ANTHROPIC_API_KEY=
# Optional; default claude-sonnet-5-5. Part of the demo's preset cache key.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Claude calls the guest demo may make per rolling 24 hours, across all
# visitors; default 40, 0 turns guest generation off.
# GUEST_GENERATIONS_PER_DAY=40
# Local testing only: npm run dev:anthropic-stub, with ANTHROPIC_API_KEY=stub.
# ANTHROPIC_BASE_URL=http://127.0.0.1:4030

# --- Live trading -----------------------------------------------------------
# Kill switch for real brokerage orders, checked at pre-flight, at confirm, and on
# every leg. Default false. Set true only in Production: Vercel previews
# (VERCEL_ENV=preview, set by Vercel) are always off whatever this says.
LIVE_TRADING_ENABLED=false

# --- Other ------------------------------------------------------------------
# Optional. The canonical URL; validated by /api/health, not otherwise read.
APP_BASE_URL=http://127.0.0.1:3000
# Set by Vercel; don't set them yourself. VERCEL_ENV gates Live and labels /api/health,
# VERCEL_GIT_COMMIT_SHA is reported by /api/health.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
